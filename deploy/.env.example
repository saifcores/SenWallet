# Copy to deploy/.env and adjust. Never commit deploy/.env.
POSTGRES_USER=senwallet
POSTGRES_PASSWORD=senwallet
LEDGER_OWNER_PASSWORD=ledger_owner
LEDGER_DB_PASSWORD=ledger_app
WALLET_OWNER_PASSWORD=wallet_owner
WALLET_DB_PASSWORD=wallet_app
RABBITMQ_USER=senwallet
RABBITMQ_PASSWORD=senwallet
KEYCLOAK_ADMIN_PASSWORD=admin
WALLET_SERVICE_CLIENT_SECRET=wallet-service-secret
# Test users (adama, binta, ops, finance, compliance, approver) use
# password "password". The hashes live in deploy/keycloak/senwallet-realm.json.

# Simulators (M6)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
SIMULATOR_HMAC_SECRET=sim-hmac-secret
# Leave empty until payments (M7) exposes webhook receivers.
CALLBACK_BASE_URL=
MNO_WAVE_FLOAT=100000000
MNO_ORANGE_FLOAT=100000000

