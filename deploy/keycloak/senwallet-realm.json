    },
    {
      "username": "ops",
      "enabled": true,
      "firstName": "Ops",
      "lastName": "Senwallet",
      "email": "ops@senwallet.local",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "password", "temporary": false }
      ],
      "realmRoles": ["ops"]
    },
    {
      "username": "finance",
      "enabled": true,
      "firstName": "Finance",
      "lastName": "Senwallet",
      "email": "finance@senwallet.local",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "password", "temporary": false }
      ],
      "realmRoles": ["finance"]
    },
    {
      "username": "compliance",
      "enabled": true,
      "firstName": "Compliance",
      "lastName": "Senwallet",
