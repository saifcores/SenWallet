{
  "id": "senwallet",
  "realm": "senwallet",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "resetPasswordAllowed": false,
  "verifyEmail": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 300,
  "requiredActions": [
    {
      "alias": "VERIFY_PROFILE",
      "name": "Verify Profile",
      "providerId": "VERIFY_PROFILE",
      "enabled": false,
      "defaultAction": false
    }
  ],
  "roles": {
    "realm": [
      { "name": "customer", "composite": false, "clientRole": false },
      { "name": "ops", "composite": false, "clientRole": false },
      { "name": "finance", "composite": false, "clientRole": false },
      { "name": "compliance", "composite": false, "clientRole": false },
      { "name": "approver", "composite": false, "clientRole": false }
    ]
  },
  "users": [
